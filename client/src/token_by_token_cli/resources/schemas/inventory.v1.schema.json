{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "entries"],
  "properties": {
    "schema_version": {"const": "inventory.v1"},
    "classification": {"const": "synthetic_mock"},
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "media_type", "sha256"],
        "properties": {
          "path": {"enum": ["events.jsonl", "replay.json"]},
          "size": {"type": "integer", "minimum": 1, "maximum": 8388608},
          "media_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
