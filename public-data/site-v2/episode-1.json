  "metric_definitions": [
    {
      "id": "output_tps",
      "explanation": "Successful output tokens per measured second."
    },
    {
      "id": "ttft_p50_ms",
      "explanation": "Median client-visible time to first token."
    },
    {
      "id": "ttft_p95_ms",
      "explanation": "95th-percentile client-visible time to first token."
    },
    {
      "id": "tpot_p50_ms",
      "explanation": "Median time per output token after the first token."
    },
    {
      "id": "decode_p10_tps",
      "explanation": "Ten-percentile per-request decode speed; 90% of valid requests are at least this fast."
    },
    {
      "id": "error_rate_pct",
      "explanation": "Share of measured requests that did not satisfy the validity contract."
    },
    {
      "id": "running_requests_mean",
      "explanation": "Mean runtime-native running-request gauge in the measured window."
    },
    {
      "id": "waiting_requests_mean",
      "explanation": "Mean runtime-native waiting-request gauge in the measured window."
    },
    {
      "id": "cache_context",
      "explanation": "Available cache context retained without cross-engine normalization."
    },
    {
      "id": "gpu_utilization_pct",
      "explanation": "Mean sampled device utilization in the measured window."
    },
    {
      "id": "gpu_memory_gib",
      "explanation": "Maximum sampled device memory use in the measured window."
    },
    {
      "id": "gpu_power_w",
      "explanation": "Mean sampled board power in the measured window."
    }
  ],
  "schema_version": "token-by-token.public-site-projection.v1"
}
