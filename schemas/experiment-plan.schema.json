{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-by-token.dev/schemas/experiment-plan.v1.json",
  "title": "Inference Lab planning-only experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","planning_only","execution_ready","execution_authorized","identity","hypothesis","model","runtime_lanes","hardware","optimizations","workload","quality","slos","cost"],
  "properties": {
    "schema_version": {"const":"inference-lab.experiment-plan.v1"},
    "planning_only": {"const":true}, "execution_ready": {"const":false}, "execution_authorized": {"const":false},
    "identity": {"type":"object","additionalProperties":false,"required":["episode","track","template_id","template_version","label"],"properties":{"episode":{"type":"integer","minimum":1,"maximum":16},"track":{"enum":["serving","model","training","decision","topology","platform","release"]},"template_id":{"type":"string","minLength":1,"maxLength":100},"template_version":{"type":"integer","minimum":1},"label":{"type":"string","minLength":1,"maxLength":120}}},
    "hypothesis": {"enum":["slow_first_token","slow_decode","throughput_collapse","high_cost"]},
    "model": {"type":"object","additionalProperties":false,"required":["model_id","revision","tokenizer_id","tokenizer_revision","template_id"],"properties":{"model_id":{"$ref":"#/$defs/identityString"},"revision":{"$ref":"#/$defs/identityString"},"tokenizer_id":{"$ref":"#/$defs/identityString"},"tokenizer_revision":{"$ref":"#/$defs/identityString"},"template_id":{"$ref":"#/$defs/identityString"}}},
    "runtime_lanes": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["engine","selected","requested_version","image_digest"],"properties":{"engine":{"enum":["vllm","sglang"]},"selected":{"type":"boolean"},"requested_version":{"type":["string","null"],"maxLength":100},"image_digest":{"type":["string","null"],"maxLength":200}}}},
    "hardware": {"type":"object","additionalProperties":false,"required":["gpu_type","gpu_memory_gb","gpu_count","node_count"],"properties":{"gpu_type":{"type":"string","minLength":1,"maxLength":100},"gpu_memory_gb":{"type":["number","null"],"minimum":1,"maximum":1000},"gpu_count":{"type":"integer","minimum":1,"maximum":64},"node_count":{"type":"integer","minimum":1,"maximum":64}}},
    "optimizations": {"type":"object","additionalProperties":false,"required":["prefix_caching","cache_policy","chunked_prefill","chunk_token_budget","attention_backend","weight_precision","weight_artifact","kv_precision","speculative_method","draft_model_id","structured_output"],"properties":{"prefix_caching":{"enum":["off","requested"]},"cache_policy":{"enum":["cold","warm","mixed"]},"chunked_prefill":{"enum":["off","requested"]},"chunk_token_budget":{"type":["integer","null"],"minimum":1,"maximum":1048576},"attention_backend":{"enum":["auto","flashattention2","flashattention3","triton"]},"weight_precision":{"enum":["bf16","fp16","fp8","int8","int4"]},"weight_artifact":{"$ref":"#/$defs/identityString"},"kv_precision":{"enum":["auto","fp16","fp8"]},"speculative_method":{"enum":["none","draft_model"]},"draft_model_id":{"type":"string","maxLength":200},"structured_output":{"enum":["none","json_schema","grammar"]}}},
    "workload": {"type":"object","additionalProperties":false,"required":["input_tokens","output_tokens","output_contract","load_mode","concurrency","arrival_rate_rps","warmup_requests","requests","repetitions","timeout_seconds","cache_state"],"properties":{"input_tokens":{"type":"integer","minimum":1,"maximum":1048576},"output_tokens":{"type":"integer","minimum":1,"maximum":1048576},"output_contract":{"enum":["natural_stop","fixed_output"]},"load_mode":{"enum":["concurrency","arrival_rate"]},"concurrency":{"type":["integer","null"],"minimum":1,"maximum":100000},"arrival_rate_rps":{"type":["number","null"],"exclusiveMinimum":0,"maximum":100000},"warmup_requests":{"type":"integer","minimum":0,"maximum":100000},"requests":{"type":"integer","minimum":1,"maximum":1000000},"repetitions":{"type":"integer","minimum":1,"maximum":100},"timeout_seconds":{"type":"integer","minimum":1,"maximum":86400},"cache_state":{"enum":["cold","warm","mixed"]}}},
    "quality": {"type":"object","additionalProperties":false,"required":["dataset","dataset_version","metric","threshold","require_schema_validity","require_semantic_correctness"],"properties":{"dataset":{"$ref":"#/$defs/identityString"},"dataset_version":{"$ref":"#/$defs/identityString"},"metric":{"$ref":"#/$defs/identityString"},"threshold":{"type":"number","minimum":0,"maximum":1},"require_schema_validity":{"type":"boolean"},"require_semantic_correctness":{"type":"boolean"}}},
    "slos": {"type":"object","additionalProperties":false,"required":["ttft_ms","tpot_ms","end_to_end_ms","max_error_rate"],"properties":{"ttft_ms":{"type":"number","exclusiveMinimum":0,"maximum":3600000},"tpot_ms":{"type":"number","exclusiveMinimum":0,"maximum":3600000},"end_to_end_ms":{"type":"number","exclusiveMinimum":0,"maximum":3600000},"max_error_rate":{"type":"number","minimum":0,"maximum":1}}},
    "cost": {"type":"object","additionalProperties":false,"required":["desired_budget_usd","hourly_rate_usd","rate_source","rate_date","planned_duration_hours"],"properties":{"desired_budget_usd":{"$ref":"#/$defs/money"},"hourly_rate_usd":{"oneOf":[{"$ref":"#/$defs/money"},{"type":"null"}]},"rate_source":{"type":"string","minLength":1,"maxLength":200},"rate_date":{"type":["string","null"],"format":"date"},"planned_duration_hours":{"$ref":"#/$defs/money"}}}
  },
  "$defs": {
    "identityString":{"type":"string","minLength":1,"maxLength":200,"not":{"pattern":"(?:https?://|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt])"}},
    "money":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"}
  }
}
