{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-by-token.invalid/schemas/episode1-private-evidence.schema.json",
  "title": "Episode 1 private evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "plan_sha256", "material_sha256", "files", "capture_complete", "cleanup_verified"],
  "properties": {
    "schema_version": {"const": "episode1.private-evidence-index.v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "material_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "classification"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "classification": {"enum": ["request", "request_lifecycle", "telemetry", "system_source", "phase_ledger", "provider", "guard", "promotion"]}
        }
      }
    },
    "capture_complete": {"type": "boolean"},
    "cleanup_verified": {"type": "boolean"}
  }
}
