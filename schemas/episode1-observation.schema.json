{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:token-by-token:schemas:episode1-observation",
  "title": "Episode 1 request observation",
  "description": "Schema for each item in the private request-evidence records array. Semantic timestamp, status, token, and quality invariants are additionally enforced by validate_observation().",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "request_id", "block_id", "pair_id", "runtime", "cell_id", "mode", "warmup", "scheduled_order", "clock_domain", "a_ns", "b_ns", "s_ns", "f_ns", "l_ns", "d_ns", "end_ns", "content_event_count", "interchunk_gaps_ns", "input_tokens", "output_tokens", "streamed_usage_output_tokens", "tokenizer_output_tokens", "stop_reason", "status", "reason_code", "fixed_length_valid", "schema_valid", "semantic_correct", "nontruncated", "quality_task_id"],
  "properties": {
    "schema_version": {"const": "episode1.v1"},
    "evidence_class": {"enum": ["local_fixture", "provider_candidate", "provider_measurement"]},
    "request_id": {"$ref": "#/$defs/identifier"},
    "block_id": {"$ref": "#/$defs/identifier"},
    "pair_id": {"$ref": "#/$defs/identifier"},
    "runtime": {"enum": ["vllm-0.29.0", "sglang-0.5.20"]},
    "cell_id": {"enum": ["fixed-short", "fixed-medium", "natural-quality"]},
    "mode": {"enum": ["fixed_output", "natural_stop"]},
    "warmup": {"type": "boolean"},
    "scheduled_order": {"type": "integer", "minimum": 1},
    "clock_domain": {"const": "client_monotonic_ns"},
    "a_ns": {"$ref": "#/$defs/ns"},
    "b_ns": {"$ref": "#/$defs/nullableNs"},
    "s_ns": {"$ref": "#/$defs/nullableNs"},
    "f_ns": {"$ref": "#/$defs/nullableNs"},
    "l_ns": {"$ref": "#/$defs/nullableNs"},
    "d_ns": {"$ref": "#/$defs/nullableNs"},
    "end_ns": {"$ref": "#/$defs/ns"},
    "content_event_count": {"type": "integer", "minimum": 0},
    "interchunk_gaps_ns": {"type": "array", "items": {"$ref": "#/$defs/ns"}},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"$ref": "#/$defs/nullableInteger"},
    "streamed_usage_output_tokens": {"$ref": "#/$defs/nullableInteger"},
    "tokenizer_output_tokens": {"$ref": "#/$defs/nullableInteger"},
    "stop_reason": {"enum": ["cancelled", "eos", "error", "length", "not_started", "stop", "timeout"]},
    "status": {"enum": ["success", "transport_failure", "http_failure", "sse_failure", "timeout", "cancelled", "unsent"]},
    "reason_code": {"enum": ["none", "transport", "http_status", "malformed_sse", "missing_usage", "token_mismatch", "request_deadline", "cell_deadline", "cancelled_on_drain", "tunnel_lost", "not_dispatched", "invalid_stop_reason", "truncated", "quality_invalid"]},
    "fixed_length_valid": {"$ref": "#/$defs/nullableBoolean"},
    "schema_valid": {"$ref": "#/$defs/nullableBoolean"},
    "semantic_correct": {"$ref": "#/$defs/nullableBoolean"},
    "nontruncated": {"$ref": "#/$defs/nullableBoolean"},
    "quality_task_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"},
    "ns": {"type": "integer", "minimum": 0},
    "nullableNs": {"type": ["integer", "null"], "minimum": 0},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "nullableBoolean": {"type": ["boolean", "null"]}
  }
}
