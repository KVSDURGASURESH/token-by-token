{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:token-by-token:schemas:episode1-protocol",
  "title": "Episode 1 frozen planning protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "question", "scope_limit", "execution_ready", "approval_phrase", "candidate_hardware", "model", "runtimes", "controls", "cells", "blocks", "same_device_pairing", "quality", "totals", "seed", "provider_inputs", "operator_policy_proposal", "hashes", "protocol_sha256"],
  "properties": {
    "schema_version": {"const": "episode1.v1"},
    "classification": {"const": "planning_only"},
    "question": {"type": "string", "minLength": 1},
    "scope_limit": {"type": "string", "minLength": 1},
    "execution_ready": {"const": false},
    "approval_phrase": {"type": "null"},
    "candidate_hardware": {"$ref": "#/$defs/candidateHardware"},
    "model": {"$ref": "#/$defs/model"},
    "runtimes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/runtime"}},
    "controls": {"$ref": "#/$defs/controls"},
    "cells": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/cell"}},
    "blocks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/block"}},
    "same_device_pairing": {"type": "string", "minLength": 1},
    "quality": {"$ref": "#/$defs/quality"},
    "totals": {"$ref": "#/$defs/totals"},
    "seed": {"type": "integer"},
    "provider_inputs": {"$ref": "#/$defs/providerInputs"},
    "operator_policy_proposal": {"$ref": "#/$defs/operatorPolicy"},
    "hashes": {"$ref": "#/$defs/hashes"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableImageDigest": {"anyOf": [{"$ref": "#/$defs/imageDigest"}, {"type": "null"}]},
    "candidateHardware": {"type": "object", "additionalProperties": false, "required": ["count", "gpu", "provider_verified"], "properties": {"count": {"const": 1}, "gpu": {"const": "NVIDIA H100 80GB HBM3"}, "provider_verified": {"const": false}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["repository", "revision", "precision", "max_context_tokens"], "properties": {"repository": {"type": "string"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "precision": {"const": "bf16"}, "max_context_tokens": {"const": 4096}}},
    "requestDialect": {"type": "object", "additionalProperties": false, "required": ["disabled_top_k", "max_tokens_field"], "properties": {"disabled_top_k": {"type": ["integer", "null"]}, "max_tokens_field": {"enum": ["max_tokens", "max_completion_tokens"]}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["id", "upstream_linux_amd64_digest", "derived_image_digest", "gpu_compatibility_verified", "launch_flags", "request_dialect"], "properties": {"id": {"enum": ["vllm-0.29.0", "sglang-0.5.20"]}, "upstream_linux_amd64_digest": {"$ref": "#/$defs/imageDigest"}, "derived_image_digest": {"$ref": "#/$defs/nullableImageDigest"}, "gpu_compatibility_verified": {"const": false}, "launch_flags": {"type": "array", "items": {"type": "string"}}, "request_dialect": {"$ref": "#/$defs/requestDialect"}}},
    "controls": {"type": "object", "additionalProperties": false, "required": ["adapters", "constrained_decoding", "kv_memory_fraction", "max_active_requests", "prefix_reuse", "quantization", "repetition_penalty", "speculation", "temperature", "top_k", "top_p"], "properties": {"adapters": {"const": false}, "constrained_decoding": {"const": false}, "kv_memory_fraction": {"type": "number"}, "max_active_requests": {"const": 4}, "prefix_reuse": {"const": false}, "quantization": {"const": false}, "repetition_penalty": {"type": "number"}, "speculation": {"const": false}, "temperature": {"const": 0}, "top_k": {"const": "disabled_by_validated_runtime_dialect"}, "top_p": {"type": "number"}}},
    "slos": {"type": "object", "additionalProperties": false, "required": ["e2e", "ttft"], "properties": {"e2e": {"type": "number", "exclusiveMinimum": 0}, "ttft": {"type": "number", "exclusiveMinimum": 0}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["id", "mode", "input_tokens", "output_tokens", "concurrency", "requests", "warmups", "request_deadline_seconds", "cell_deadline_seconds", "slos_ms"], "properties": {"id": {"enum": ["fixed-short", "fixed-medium", "natural-quality"]}, "mode": {"enum": ["fixed_output", "natural_stop"]}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 1}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 4}, "requests": {"type": "integer", "minimum": 1}, "warmups": {"type": "integer", "minimum": 1}, "request_deadline_seconds": {"type": "number", "exclusiveMinimum": 0}, "cell_deadline_seconds": {"type": "number", "exclusiveMinimum": 0}, "slos_ms": {"$ref": "#/$defs/slos"}}},
    "block": {"type": "object", "additionalProperties": false, "required": ["block_id", "pair_id", "position", "runtime", "fresh_process_required", "cell_order"], "properties": {"block_id": {"type": "string"}, "pair_id": {"type": "string"}, "position": {"type": "integer", "minimum": 1, "maximum": 6}, "runtime": {"enum": ["vllm-0.29.0", "sglang-0.5.20"]}, "fresh_process_required": {"const": true}, "cell_order": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["fixed-short", "fixed-medium", "natural-quality"]}}}},
    "quality": {"type": "object", "additionalProperties": false, "required": ["schema_valid_required", "semantic_correct_minimum", "tasks_per_block"], "properties": {"schema_valid_required": {"const": 24}, "semantic_correct_minimum": {"const": 23}, "tasks_per_block": {"const": 24}}},
    "totals": {"type": "object", "additionalProperties": false, "required": ["measured_requests", "fixed_requests", "natural_requests", "warmups"], "properties": {"measured_requests": {"const": 528}, "fixed_requests": {"const": 384}, "natural_requests": {"const": 144}, "warmups": {"const": 72}}},
    "providerInputs": {"type": "object", "additionalProperties": false, "required": ["account_balance", "container_digests", "price_per_hour", "stock", "supported_flags"], "properties": {"account_balance": {"type": "null"}, "container_digests": {"const": "unknown"}, "price_per_hour": {"type": "null"}, "stock": {"const": "unknown"}, "supported_flags": {"const": "unknown"}}},
    "operatorPolicy": {"type": "object", "additionalProperties": false, "required": ["approved", "maximum_resource_lifetime_minutes", "maximum_spend_usd", "minimum_final_balance_usd"], "properties": {"approved": {"const": false}, "maximum_resource_lifetime_minutes": {"type": "number", "exclusiveMinimum": 0}, "maximum_spend_usd": {"type": "number", "exclusiveMinimum": 0}, "minimum_final_balance_usd": {"type": "number", "minimum": 0}}},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["corpus_sha256", "harness_sha256", "prompt_evidence_sha256", "chat_template_sha256", "tokenizer_asset_manifest_sha256"], "properties": {"corpus_sha256": {"$ref": "#/$defs/sha256"}, "harness_sha256": {"$ref": "#/$defs/sha256"}, "prompt_evidence_sha256": {"$ref": "#/$defs/sha256"}, "chat_template_sha256": {"$ref": "#/$defs/sha256"}, "tokenizer_asset_manifest_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
