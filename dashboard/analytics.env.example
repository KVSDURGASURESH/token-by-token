# Optional privacy-first Umami analytics. The static site sends no analytics
# unless both values below are present at build time.
VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Restrict collection to the production hostnames. Comma separated.
VITE_UMAMI_DOMAINS=example.com,www.example.com
