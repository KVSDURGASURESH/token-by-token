#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
DASHBOARD="$ROOT/dashboard"
DIST="$DASHBOARD/dist"

usage() {
  cat <<'EOF'
Usage: scripts/quick-test <command> [options]

Commands:
  demo       Launch the loopback bridge with deterministic local demo lanes
  serve      Launch the loopback bridge for configured endpoints
  request    Run one CLI request through an already-running bridge
  compare    Run a CLI comparison through an already-running bridge
  episode    Run one Episode 1-16 endpoint rehearsal through the bridge
  setup      Install pinned dashboard dependencies and build the dashboard
  help       Show this message

Examples:
  scripts/quick-test demo
  scripts/quick-test request --profile demo-fast --prompt 'Explain TTFT.'
  scripts/quick-test compare --profile demo-fast --profile demo-steady \
    --prompt 'Explain TTFT.' --repetitions 3
  scripts/quick-test episode --episode 3 --profile demo-fast --profile demo-steady
  scripts/quick-test serve --profiles /private/path/quick-test-profiles.json
EOF
}

python_command() {
  if [ -x "$ROOT/.venv/bin/python" ]; then
    printf '%s\n' "$ROOT/.venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    command -v python3
  else
    echo "Python 3 is required." >&2
    exit 1
  fi
}

build_dashboard() {
  if ! command -v npm >/dev/null 2>&1; then
    echo "npm is required to build the dashboard." >&2
    exit 1
  fi
  npm --prefix "$DASHBOARD" ci
  npm --prefix "$DASHBOARD" run build
}

ensure_dashboard() {
  if [ ! -f "$DIST/index.html" ]; then
    echo "Dashboard build is missing; installing pinned dependencies and building it now."
    build_dashboard
  fi
}

command=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  demo|serve)
    ensure_dashboard
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
      exec "$(python_command)" "$ROOT/scripts/episode1_playground.py" "$command" "$@"
    ;;
  request|compare|episode)
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
      exec "$(python_command)" "$ROOT/scripts/episode1_playground.py" "$command" "$@"
    ;;
  setup)
    build_dashboard
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
